# Copy to analyst/.env for local runs (adk web / adk run / mcp_server.py).
# adk deploy also reads GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION from here.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-gemini-api-key
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# ANALYST_MODEL=gemini-flash-latest
